# Build output
/dist/
/build/
*.exe
*.exe~
# Anchor to root: bare `rave-mate` also matched the cmd/rave-mate/ package dir, so the
# entry point was never committed and CI's `go build ./cmd/rave-mate` 404'd.
/rave-mate
/rave-mate-*
*.app

# Zig build output (native/zigcore)
.zig-cache/
zig-out/

# Go
*.test
*.out
/vendor/
go.work
go.work.sum

# Runtime / user data
*.log
*.jsonl
/.run/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
rave-mate-debug.log

# ravemidi driver build output (keep committed signing/submission tooling;
# `build/*` not `build/` so the negations below can re-include)
/driver/ravemidi/build/*
!/driver/ravemidi/build/sign-cab.ps1
!/driver/ravemidi/build/attest/
internal/mfenc/embedded/*.exe
internal/webui/embedded/*.exe
