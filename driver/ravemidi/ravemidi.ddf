; MakeCab directive file: builds the attestation-submission cab.
; Usage: MakeCab /f ravemidi.ddf   (run from the built-output dir)
.OPTION EXPLICIT
.Set CabinetFileCountThreshold=0
.Set FolderFileCountThreshold=0
.Set FolderSizeThreshold=0
.Set MaxCabinetSize=0
.Set MaxDiskFileCount=0
.Set MaxDiskSize=0
.Set CompressionType=MSZIP
.Set Cabinet=on
.Set Compress=on
.Set CabinetNameTemplate=ravemidi.cab
.Set DestinationDir=ravemidi
; package = subfolder with inf+sys+pdb (pdb required for MS crash analysis)
ravemidi.inf
ravemidi.sys
ravemidi.pdb
