<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{E1D0A9C4-7B3F-4A66-9D21-5C8E0F42B7A1}</ProjectGuid>
    <TemplateGuid>{497e31cb-056b-4f31-abb8-04cc0aabbdc3}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>12.0</MinimumVisualStudioVersion>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RootNamespace>ravemidi</RootNamespace>
    <DriverType>WDM</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <!-- Skip the in-build DPVerifier/InfVerif MSBuild task: it fails to load
         x86\InfVerif.dll on the CI runner. CI runs InfVerif.exe as an explicit
         step so the DCH/declarative gate is preserved. -->
    <SkipPackageVerification>true</SkipPackageVerification>
    <!-- No in-build signing: CI has no cert, and release signing is Microsoft
         attestation (Partner Center), not a local test-cert. Install/dev-test
         signs out-of-band per the design doc. -->
    <SignMode>Off</SignMode>
    <EnableTestSign>false</EnableTestSign>
    <!-- No in-build .cat: the loadable catalog comes from Microsoft attestation
         (which regenerates it), not inf2cat here. Dev-test builds Inf2Cat locally. -->
    <EnableInf2cat>false</EnableInf2cat>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <SpectreMitigation>Spectre</SpectreMitigation>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <PropertyGroup>
    <IncludePath>$(ProjectDir);$(IncludePath)</IncludePath>
    <OutDir>$(ProjectDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(ProjectDir)build\obj\$(Configuration)\$(Platform)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- POOL_NX_OPTIN: NX nonpaged pool by default = HVCI requirement.
           _NEW_DELETE_OPERATORS_: suppress stdunk's deprecated operator new/delete;
           we supply ExAllocatePool2 versions in kalloc.cpp. -->
      <PreprocessorDefinitions>POOL_NX_OPTIN=1;_NEW_DELETE_OPERATORS_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)portcls.lib;$(DDK_LIB_PATH)stdunk.lib;$(DDK_LIB_PATH)wdmsec.lib;$(DDK_LIB_PATH)ntstrsafe.lib;$(DDK_LIB_PATH)ks.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Inf>
      <TimeStamp>*</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="adapter.cpp" />
    <ClCompile Include="miniport.cpp" />
    <ClCompile Include="fifo.cpp" />
    <ClCompile Include="kalloc.cpp" />
    <ClCompile Include="guids.cpp" />
    <ClCompile Include="mirror.cpp" />
    <ClCompile Include="config.cpp" />
    <ClCompile Include="managed.cpp" />
    <ClInclude Include="ioctl.h" />
    <ClInclude Include="miniport.h" />
    <ClInclude Include="fifo.h" />
    <ClInclude Include="kalloc.h" />
    <ClInclude Include="mirror.h" />
    <ClInclude Include="config.h" />
    <ClInclude Include="managed.h" />
    <Inf Include="ravemidi.inf" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
